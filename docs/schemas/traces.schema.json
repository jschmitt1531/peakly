{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://OWNER.github.io/peakly/schemas/traces.schema.json",
  "title": "Peakly traces export",
  "description": "Traces export, schema version 2: trace summary rows plus long-format data rows (CSV) or per-trace arrays (JSON).",
  "$defs": {
    "traceRow": {
      "title": "trace-row",
      "description": "One row of a Peakly trace summary export.",
      "type": "object",
      "required": [
        "schema_version",
        "trace_id",
        "name",
        "role",
        "x_unit",
        "y_unit",
        "n_points",
        "x_min",
        "x_max",
        "source_kind",
        "source_format",
        "source_filename",
        "digitized",
        "dx_unc",
        "dy_unc",
        "n_peaks",
        "sample_name",
        "sample_id",
        "inj_vol",
        "instrument",
        "detector",
        "processing",
        "calibration_level"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "description": "Peakly export schema version."
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Stable trace id."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Trace name."
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "description": "signal, or an auxiliary channel role (gradient, conductivity, pH, …)."
        },
        "x_unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "x unit (min or mL)."
        },
        "y_unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "y unit."
        },
        "n_points": {
          "type": "integer",
          "description": "Number of data points."
        },
        "x_min": {
          "type": [
            "number",
            "null"
          ],
          "description": "First x value. Unit: {x}."
        },
        "x_max": {
          "type": [
            "number",
            "null"
          ],
          "description": "Last x value. Unit: {x}."
        },
        "source_kind": {
          "type": [
            "string",
            "null"
          ],
          "description": "file | image | paste | sample | derived."
        },
        "source_format": {
          "type": [
            "string",
            "null"
          ],
          "description": "Detected file format."
        },
        "source_filename": {
          "type": [
            "string",
            "null"
          ],
          "description": "Original file name."
        },
        "digitized": {
          "type": "boolean",
          "description": "true if digitized from an image."
        },
        "dx_unc": {
          "type": [
            "number",
            "null"
          ],
          "description": "± x uncertainty per pixel (digitized only). Unit: {x}."
        },
        "dy_unc": {
          "type": [
            "number",
            "null"
          ],
          "description": "± y uncertainty per pixel (digitized only). Unit: {y}."
        },
        "n_peaks": {
          "type": "integer",
          "description": "Number of integrated peaks."
        },
        "sample_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Run info: sample name."
        },
        "sample_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Run info: sample id."
        },
        "inj_vol": {
          "type": [
            "string",
            "null"
          ],
          "description": "Run info: injection volume. Unit: µL."
        },
        "instrument": {
          "type": [
            "string",
            "null"
          ],
          "description": "Run info: instrument."
        },
        "detector": {
          "type": [
            "string",
            "null"
          ],
          "description": "Run info: detector / wavelength."
        },
        "processing": {
          "type": [
            "string",
            "null"
          ],
          "description": "Smoothing / baseline / detection settings summary."
        },
        "calibration_level": {
          "type": [
            "string",
            "null"
          ],
          "description": "Analyte:concentration pairs if this trace is a calibration standard."
        }
      },
      "x-peakly-schema-version": 2,
      "x-unit-templates": {
        "{x}": "trace x unit (min or mL)",
        "{y}": "trace y unit",
        "{elu}": "%B or salt/imidazole unit",
        "{conc}": "calibration concentration unit",
        "{resp}": "response unit (y·x for area, y for height)"
      }
    },
    "dataRow": {
      "title": "data-row",
      "description": "One point of the long-format trace data export.",
      "type": "object",
      "required": [
        "trace_id",
        "trace_name",
        "x",
        "y",
        "y_processed",
        "digitized"
      ],
      "properties": {
        "trace_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Stable trace id."
        },
        "trace_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Trace name."
        },
        "x": {
          "type": [
            "number",
            "null"
          ],
          "description": "Time or volume. Unit: {x}."
        },
        "y": {
          "type": [
            "number",
            "null"
          ],
          "description": "Raw signal as imported. Unit: {y}."
        },
        "y_processed": {
          "type": [
            "number",
            "null"
          ],
          "description": "Smoothed and baseline-corrected signal used for integration. Unit: {y}."
        },
        "digitized": {
          "type": "boolean",
          "description": "true if digitized from an image."
        }
      },
      "x-peakly-schema-version": 2,
      "x-unit-templates": {
        "{x}": "trace x unit (min or mL)",
        "{y}": "trace y unit",
        "{elu}": "%B or salt/imidazole unit",
        "{conc}": "calibration concentration unit",
        "{resp}": "response unit (y·x for area, y for height)"
      }
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "type": "object"
    },
    "traces": {
      "type": "array"
    },
    "traceRows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/traceRow"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataRow"
      }
    }
  }
}
