{
  "name": "Peakly: in-browser chromatogram analysis",
  "short_name": "Peakly",
  "description": "Free-to-use, single-file HPLC/FPLC chromatogram analyzer that runs entirely in your browser.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "browser",
  "background_color": "#f4f6f9",
  "theme_color": "#2563eb",
  "icons": [
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
